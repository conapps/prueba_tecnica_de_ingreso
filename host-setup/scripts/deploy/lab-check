#!/usr/bin/env bash
# Verificación rápida del lab — solo evaluador (usuario ubuntu).
set -uo pipefail

if [[ "$(id -un)" != ubuntu ]]; then
  echo "lab-check: solo evaluador (ubuntu)." >&2
  exit 1
fi

ansible_ok=0

echo "=== Ping mgmt ==="
for ip in 10.0.0.80 10.0.0.81 10.0.0.82; do
  printf '%-14s ' "$ip"
  ping -c1 -W2 "$ip" &>/dev/null && echo OK || echo FAIL
done

echo ""
echo "=== Ansible (conatel) — show ip interface brief ==="
if sudo -n /opt/prueba-tecnica-eval/bin/ansible-participante -- cisco -m cisco.ios.ios_command -a 'commands="show ip interface brief"' --one-line; then
  ansible_ok=1
else
  echo "Ansible: algún host falló (revisar salida arriba)."
fi

echo ""
echo "=== SNMP (snmp-demo) ==="
for ip in 10.0.0.80 10.0.0.81 10.0.0.82; do
  printf '%-14s ' "$ip"
  if command -v snmpget &>/dev/null; then
    snmpget -v2c -c snmp-demo -t2 -On "$ip" 1.3.6.1.2.1.1.5.0 2>/dev/null | awk '{print $4}' || echo FAIL
  else
    echo '(snmpget no instalado)'
  fi
done

echo ""
echo "Diagnóstico SSH manual (demo): ssh-rtr | ssh-core | ssh-edge  (pass: Demo123!)"
[[ "${ansible_ok}" -eq 1 ]] || exit 1
