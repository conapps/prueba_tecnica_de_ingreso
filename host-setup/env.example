# Variables de entorno — Prueba técnica (formato)
#
# Para cada instancia:
# 1. Copiar este archivo a env.prueba-tecnica (mismo directorio).
# 2. Completar todas las variables ZABBIX_*.
# 3. Desplegar con install-on-demo-vm.sh (copia a ~/prueba-tecnica/.env.prueba-tecnica en la VM).
#
# El participante lee ZABBIX_* desde ~/prueba-tecnica/.env.prueba-tecnica (no va en plantilla-entrega).

export ZABBIX_URL=""
export ZABBIX_USER=""
export ZABBIX_PASSWORD=""
export ZABBIX_TOKEN=""
