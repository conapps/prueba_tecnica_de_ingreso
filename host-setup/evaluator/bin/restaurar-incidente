#!/usr/bin/env bash
# Evaluador: restaurar escenario (rollback + permitir nuevo disparar-incidente).
set -euo pipefail

if [[ "$(id -un)" != ubuntu ]]; then
  echo "restaurar-incidente: solo evaluador (ubuntu)." >&2
  exit 1
fi

exec sudo -n /opt/prueba-tecnica-eval/bin/restaurar-incidente-run "$@"
