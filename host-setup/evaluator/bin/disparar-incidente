#!/usr/bin/env bash
# Activa el incidente de Parte 3 (ejecutar como root vía sudo).
set -euo pipefail

OPT_ROOT="/opt/prueba-tecnica-eval"
STATE="${OPT_ROOT}/state/incident.triggered"
CONF="${OPT_ROOT}/incident.conf"
ANSIBLE_DIR="${OPT_ROOT}/ansible"
CREDS="${OPT_ROOT}/cisco-credentials.env"

if [[ -f "${STATE}" ]]; then
  echo "El incidente ya fue activado en esta prueba." >&2
  echo "Si necesitás reiniciar el escenario, contactá al evaluador." >&2
  exit 1
fi

# shellcheck source=/dev/null
source "${CONF}"

: "${FAIL_HOST:?}"
: "${FAIL_INTERFACE:?}"

export ANSIBLE_CONFIG="${ANSIBLE_DIR}/ansible.cfg"
export HOME="/home/demo"

set -a
# shellcheck source=/dev/null
source "${CREDS}"
set +a
export ANSIBLE_CISCO_USER ANSIBLE_CISCO_PASSWORD ANSIBLE_CISCO_ENABLE

PYVER="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
export PYTHONPATH="${HOME}/.local/lib/python${PYVER}/site-packages:/usr/local/lib/python${PYVER}/dist-packages:${PYTHONPATH:-}"

cd "${ANSIBLE_DIR}"
LOG="${OPT_ROOT}/state/ansible.log"
mkdir -p "$(dirname "${LOG}")"

if ! ansible-playbook playbooks/fail_interface.yml \
  --limit "${FAIL_HOST}" \
  -e "fail_host=${FAIL_HOST}" \
  -e "fail_interface=${FAIL_INTERFACE}" \
  >>"${LOG}" 2>&1; then
  echo "No se pudo activar el incidente. Contactá al evaluador." >&2
  exit 1
fi

mkdir -p "$(dirname "${STATE}")"
date -Iseconds > "${STATE}"
chgrp ubuntu "${LOG}" "${STATE}" 2>/dev/null || true
chmod 664 "${LOG}" "${STATE}" 2>/dev/null || true

echo "Incidente activado."
echo "Esperá unos minutos a que Zabbix lo refleje y revisá tu solución."
echo "Luego investigá, remediá con Ansible y validá la recuperación."
