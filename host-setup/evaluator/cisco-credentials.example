# Credenciales Ansible Cisco — formato
#
# Para cada instancia:
# 1. Copiar este archivo a cisco-credentials.env (mismo directorio).
# 2. Completar ANSIBLE_CISCO_USER, ANSIBLE_CISCO_PASSWORD y ANSIBLE_CISCO_ENABLE.
# 3. Desplegar con install-on-demo-vm.sh (copia a /opt/prueba-tecnica-eval/cisco-credentials.env).
#
# Solo root en la VM; el participante usa lab-ansible (no lee este archivo).

ANSIBLE_CISCO_USER=
ANSIBLE_CISCO_PASSWORD=
ANSIBLE_CISCO_ENABLE=
